{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(pytest:*)",
      "Bash(uv run pytest:*)",
      "Bash(ruff:*)",
      "Bash(uv run ruff:*)",
      "Bash(mypy:*)",
      "Bash(uv run mypy:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(docker compose:*)",
      "Bash(alembic:*)",
      "Bash(uv run alembic:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.staging)",
      "Read(./**/.env.staging)",
      "Read(./.env.prod)",
      "Read(./**/.env.prod)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Edit(./.env.local)",
      "Edit(./**/.env.local)",
      "Edit(./.env.staging)",
      "Edit(./**/.env.staging)",
      "Edit(./.env.prod)",
      "Edit(./**/.env.prod)",
      "Edit(./.env.production)",
      "Edit(./**/.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-format.sh"
          }
        ]
      }
    ]
  }
}
