{
	# Local: SITE_ADDRESS=http://localhost ; staging/prod: the domain (automatic HTTPS).
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# Keycloak admin console and master realm are never public (spec section 4).
	@kc_admin path /auth/admin* /auth/realms/master*
	respond @kc_admin 404

	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"
	}
}
