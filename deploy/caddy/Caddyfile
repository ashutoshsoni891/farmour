{
	# Local: SITE_ADDRESS=http://localhost ; staging/prod: the domain (automatic HTTPS).
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# Only the app realm and Keycloak's static assets are public. The admin console, admin API
	# and master realm are never reachable through Caddy (spec section 4).
	@kc_public path /auth/realms/farm/* /auth/resources/* /auth/js/*
	handle @kc_public {
		reverse_proxy keycloak:8080
	}
	handle /auth/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	handle {
		# Our policy applies to the app pages only; Keycloak sets its own.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; font-src 'self'; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:; child-src blob:; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
		root * /srv
		try_files {path} /index.html
		file_server
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"
	}
}
