  "components": {
    "schemas": {
      "AdminUserOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "hi"
            ],
            "title": "Language"
          },
          "unit_pref": {
            "type": "string",
            "enum": [
              "sqft",
              "acre",
              "bigha",
              "sqm"
            ],
            "title": "Unit Pref"
          },
          "bigha_sqft": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bigha Sqft"
          },
          "is_admin": {
            "type": "boolean",
            "title": "Is Admin"
          },
          "is_agronomist": {
            "type": "boolean",
            "title": "Is Agronomist"
          }
        },
        "type": "object",
        "required": [
          "id",
          "phone",
          "name",
          "email",
          "language",
          "unit_pref",
          "bigha_sqft",
          "is_admin",
          "is_agronomist"
        ],
        "title": "AdminUserOut"
      },
      "AdminUserUpdate": {
        "properties": {
          "is_admin": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Admin"
          },
          "is_agronomist": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Agronomist"
          },
          "revoke_sessions": {
            "type": "boolean",
            "title": "Revoke Sessions",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AdminUserUpdate"
      },
      "FarmCreate": {
        "properties": {
          "site_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ground",
                  "terrace"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Site Type"
          },
          "district": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "District"
          },
          "village": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Village"
          },
          "lat": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "lng": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lng"
          },
          "goal": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "home_food",
                  "income",
                  "both"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          },
          "budget_setup_paise": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Setup Paise"
          },
          "budget_monthly_paise": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Monthly Paise"
          },
          "labour": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "self",
                  "family",
                  "caretaker",
                  "mixed"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Labour"
          },
          "water_source": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "bore",
                  "well",
                  "canal",
                  "municipal",
                  "rain_only"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Water Source"
          },
          "water_summer_lpd": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Water Summer Lpd"
          },
          "electricity": {
            "anyOf": [
              {
