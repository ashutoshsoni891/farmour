# Copy to .env and replace every change-me value (never commit .env).
# Compose builds DATABASE_URL etc. for containers from these values.

# ---- Deployment ----
ENV=local                              # local | staging | prod
APP_BASE_URL=http://localhost          # public URL of the app (no trailing slash)
SITE_ADDRESS=http://localhost          # Caddy site: a domain on staging/prod enables HTTPS

# ---- Spec section 4 variables ----
# DATABASE_URL and VALKEY_URL are only needed when running the API outside Docker.
DATABASE_URL=postgresql+asyncpg://farm:change-me@localhost:5432/farm
VALKEY_URL=redis://localhost:6379/0
KEYCLOAK_URL=http://localhost/auth
KEYCLOAK_REALM=farm
KEYCLOAK_CLIENT_ID=farm-web
LINK_SIGNING_SECRET=change-me-at-least-32-random-characters
LLM_PROVIDER=ollama                    # used from M7
LLM_MODEL=change-me
LLM_API_KEY=dummy
EMBEDDING_MODEL=BAAI/bge-m3
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key
S3_BUCKET=farm-files
SMTP_HOST=smtp.example.com             # Keycloak emails (password reset)
SMTP_USER=dummy
SMTP_PASSWORD=dummy
TELEGRAM_BOT_TOKEN=000000:dummy        # used from M5
TELEGRAM_WEBHOOK_SECRET=change-me
WA_TOKEN=                              # WhatsApp is post-MVP; leave empty
WA_APP_SECRET=
WA_PHONE_NUMBER_ID=
GLITCHTIP_DSN=
GEOCODER_USER_AGENT=farmour/0.1 (your contact email here)   # Nominatim policy: identify yourself

# ---- Docker Compose secrets (decision 2026-09-30) ----
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
FARM_RO_PASSWORD=change-me             # read-only DB role for dev tooling (.mcp.json)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# ---- Dev tooling only (.mcp.json) ----
GITHUB_PERSONAL_ACCESS_TOKEN=
DEV_DB_READONLY_URL=postgresql://farm_ro:change-me@localhost:5432/farm
