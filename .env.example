# Copy to .env (never commit .env). All values below are dummies.
# Spec section 4 — keep this list in sync with the spec.

DATABASE_URL=postgresql+asyncpg://farm:change-me@postgres:5432/farm
VALKEY_URL=redis://valkey:6379/0

KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=farm
KEYCLOAK_CLIENT_ID=farm-api

LINK_SIGNING_SECRET=change-me-long-random-string

LLM_PROVIDER=ollama
LLM_MODEL=change-me
LLM_API_KEY=dummy
EMBEDDING_MODEL=BAAI/bge-m3

S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=dummy-access-key
S3_SECRET_KEY=dummy-secret-key
S3_BUCKET=farm-files

SMTP_HOST=smtp.example.com
SMTP_USER=dummy
SMTP_PASSWORD=dummy

TELEGRAM_BOT_TOKEN=000000:dummy
TELEGRAM_WEBHOOK_SECRET=change-me

# WhatsApp Cloud API (post-MVP, leave empty)
WA_TOKEN=
WA_APP_SECRET=
WA_PHONE_NUMBER_ID=

GLITCHTIP_DSN=

# Used by .mcp.json only (dev tooling)
GITHUB_PERSONAL_ACCESS_TOKEN=
DEV_DB_READONLY_URL=postgresql://farm_ro:change-me@localhost:5432/farm
